# ─── دیتابیس ───────────────────────────────────────────────
# پیش‌فرض: SQLite داخلی — بدون نیاز به نصب هیچ سرویسی
DB_DRIVER=sqlite
SQLITE_PATH=data/samaline.sqlite

# برای استفاده از PostgreSQL:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://localhost:5432/samaline

# ─── سرور ──────────────────────────────────────────────────
JWT_SECRET=change-me
PORT=3000
PUBLIC_FORM_BASE_URL=http://localhost:5173/f
RESPONDENT_KEY_SALT=change-me-too
# نشانی عمومی سامانه؛ لینک یادآوری، تلگرام و صفحه‌ی انتشار از روی آن ساخته می‌شوند.
# PUBLIC_URL=https://survey.example.com

# ─── پشتیبان روزانه (فقط SQLite) ────────────────────────────
# روزی یک نسخه در data/backups/daily؛ پیش‌فرض ۱۴ نسخه‌ی آخر نگه داشته می‌شود.
# DAILY_BACKUP_DISABLED=true
# DAILY_BACKUP_KEEP=14

# ─── ارسال پیامک و ایمیل ───────────────────────────────────
# local (پیش‌فرض): پیام‌ها در data/outbox/ نوشته می‌شوند — بدون سرویس بیرونی
# kavenegar: پنل پیامکی کاوه‌نگار | webhook: هر سرویس دلخواه
SMS_PROVIDER=local
# ایمیل: local | smtp (سرور ایمیل سازمان، Gmail، Zoho و…) | webhook
EMAIL_PROVIDER=local
# SMTP_HOST=mail.example.com
# درگاه ۴۶۵ برای TLS مستقیم، ۵۸۷ با STARTTLS.
# (توضیح را در همان خط مقدار ننویسید؛ systemd آن را جزو مقدار می‌خواند.)
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=
# SMTP_FROM=SamaLine <no-reply@example.com>
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=
# SMS_WEBHOOK_URL=
# EMAIL_WEBHOOK_URL=
# MESSAGING_WEBHOOK_AUTH=
OUTBOX_PATH=data/outbox

# صف ارسال درون‌فرایندی (جایگزین Redis)
MESSAGING_CONCURRENCY=5
MESSAGING_MAX_ATTEMPTS=3
MESSAGING_RETRY_DELAY_MS=500

# ─── هوش مصنوعی ────────────────────────────────────────────
# mock (پیش‌فرض): بدون کلید و بدون اینترنت کار می‌کند
# openai: هر سرویس سازگار با OpenAI، شامل مدل داخلی سازمان
AI_PROVIDER=mock
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ─── اتصال به API نرم‌افزارهای دیگر ─────────────────────────
# سرور به نشانی‌های شبکه داخلی درخواست نمی‌زند (محافظت SSRF).
# اگر سرویس مقصد واقعا داخل شبکه‌ی سازمان است، این را true کنید:
# ALLOW_PRIVATE_CONTACT_SOURCES=true
CONTACT_SOURCE_MAX_RECORDS=5000
CONTACT_SOURCE_TIMEOUT_MS=20000

# ─── صف پایدار ─────────────────────────────────────────────
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_BATCH_SIZE=10
QUEUE_RETRY_BASE_MS=5000

# ─── احراز هویت پاسخ‌دهنده ─────────────────────────────────
OTP_TTL_MS=180000
OTP_MAX_ATTEMPTS=5
RESPONDENT_TOKEN_TTL_SECONDS=7200

# ─── درگاه پرداخت ──────────────────────────────────────────
# local (پیش‌فرض): هر پرداختی موفق شمرده می‌شود — فقط برای توسعه
# zarinpal: درگاه واقعی
PAYMENT_PROVIDER=local
# ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:5174/billing/callback
PAYMENT_TIMEOUT_MS=20000

# ─── رمزنگاری راز ──────────────────────────────────────────
# کلیدهای API سرویس‌های بیرونی با این کلید رمز می‌شوند.
# اگر تنظیم نشود از JWT_SECRET استفاده می‌شود؛ در محیط واقعی جدا کنید.
# هشدار: پس از ذخیره‌ی اولین راز، عوض کردن این مقدار (یا افزودنش به نصبی که
# نداشت) داده‌ی رمزشده‌ی قبلی را غیرقابل‌خواندن می‌کند.
# SECRET_ENCRYPTION_KEY=
